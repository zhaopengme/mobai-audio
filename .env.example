# 服务配置
HOST=0.0.0.0
PORT=8000

# API Keys（逗号分隔，支持多个）
API_KEYS=sk-key1,sk-key2,sk-key3

# 并发配置
MAX_WORKERS=4

# MLX-Audio 配置
# 模型类型: kokoro, chatterbox
MODEL_TYPE=kokoro
MLX_MODEL=prince-canuma/Kokoro-82M
DEFAULT_VOICE=af_heart
DEFAULT_LANG=a
DEFAULT_SAMPLE_RATE=24000

# Chatterbox 配置示例（英文质量最好）
# MODEL_TYPE=chatterbox
# MLX_MODEL=mlx-community/Chatterbox-TTS-fp16
# 或使用 4bit 量化版本（更快更小）:
# MLX_MODEL=mlx-community/Chatterbox-TTS-4bit

# Whisper 对齐配置（用于 response_format=json）
WHISPER_MODEL=tiny
